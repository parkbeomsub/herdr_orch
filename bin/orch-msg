#!/bin/bash
# orch-msg — orch 팀의 팬 사이 메시지 전송 + 영속 대화 기록
#
# 사용법:
#   orch-msg send <역할명|pane_id> <메시지...>   보내고 로그에 기록
#   orch-msg log  [옵션]                         대화 기록 읽기 (기본 최근 30개)
#   orch-msg whoami                              내 신원 확인
#   orch-msg who                                 내 워크스페이스의 팀원 목록
#
# log 옵션:
#   --last N      최근 N개 메시지 (기본 30)
#   --from 역할   보낸 사람으로 필터
#   --to 역할     받는 사람으로 필터
#   --grep 패턴   본문 검색
#   --all         전체 출력 (주의: 파일이 크면 컨텍스트를 잡아먹는다)
#
# 신원은 환경변수로 주입된다 (orch가 팬 생성 시 넣어줌):
#   ORCH_ROLE  내 역할명      ORCH_WS   내 워크스페이스 ID
#   ORCH_PANE  내 pane_id     ORCH_LOG  로그 파일 경로
#
# 워크스페이스 격리: 대상이 내 워크스페이스 밖이면 전송을 거부한다.
# 로그가 5MB를 넘으면 자동으로 log-<날짜>.md 로 넘기고 새로 시작한다.

set -euo pipefail

ROLE="${ORCH_ROLE:-👑 오너}"
# 워크스페이스·pane은 herdr가 모든 팬에 주입하는 값을 1순위로 쓴다.
# HERDR_* 는 팬이 실제로 속한 곳을 herdr가 직접 알려주는 값이라 resume 후에도 살아 있고,
# orch가 넣은 ORCH_* 가 유실돼도 격리가 유지된다. 수동으로 띄운 팬에서도 동작한다.
WS="${HERDR_WORKSPACE_ID:-${ORCH_WS:-}}"
MYPANE="${HERDR_PANE_ID:-${ORCH_PANE:-}}"
LOG="${ORCH_LOG:-$PWD/comms/log.md}"
MAXSIZE=$((5 * 1024 * 1024))

die() { echo "orch-msg: $*" >&2; exit 1; }

command -v herdr >/dev/null 2>&1 || die "herdr를 찾을 수 없습니다"
command -v jq    >/dev/null 2>&1 || die "jq가 필요합니다"

# ── 로그 준비 + 로테이션 ─────────────────────────────
ensure_log() {
  mkdir -p "$(dirname "$LOG")"
  if [ -f "$LOG" ]; then
    local sz
    sz=$(wc -c < "$LOG" | tr -d ' ')
    if [ "$sz" -gt "$MAXSIZE" ]; then
      mv "$LOG" "${LOG%.md}-$(date '+%Y%m%d-%H%M%S').md"
      echo "orch-msg: 로그가 5MB를 넘어 회전했습니다" >&2
    fi
  fi
  if [ ! -f "$LOG" ]; then
    printf '# 에이전트 통신 로그\n\n' > "$LOG"
  fi
}

# ── 워크스페이스 확인 ────────────────────────────────
# 포커스된 워크스페이스로 폴백하지 않는다. 그렇게 하면 신원을 잃은 에이전트가
# "사용자가 지금 보고 있는 스페이스"로 메시지를 보내게 되어 격리가 조용히 무너진다.
# 알 수 없으면 보내지 않고 죽는 게 맞다.
resolve_ws() {
  [ -n "$WS" ] || die "워크스페이스를 알 수 없습니다. herdr 팬 안에서 실행하거나 ORCH_WS를 지정하세요."
  printf '%s' "$WS"
}

# ── 역할명 → pane_id (반드시 내 워크스페이스 안에서만) ──
resolve_target() { # <target> <ws>
  local t="$1" ws="$2" pid=""
  case "$t" in
    w*:p*) pid="$t" ;;
    *)
      # herdr 0.7.5부터 agent 이름은 영문 슬러그만 허용되므로(한글 거부),
      # 한글 역할명은 **팬 라벨**로 찾는다. 라벨 → agent 이름 순으로 정확일치.
      # 정확일치. 같은 라벨이 둘 이상이면 고르지 말고 죽는다 — 같은 워크스페이스에
      # orch를 두 번 돌리면 라벨이 중복될 수 있고, 그때 조용히 첫 번째를 집으면 오배송이다.
      local exact
      exact=$(herdr pane list --workspace "$ws" 2>/dev/null | jq -r --arg n "$t" '
        .result.panes[] | select((.label // "") == $n) | .pane_id')
      if [ "$(printf '%s' "$exact" | grep -c .)" -gt 1 ]; then
        die "'$t' 라벨의 팬이 여러 개입니다. pane_id로 지정하세요:
$exact"
      fi
      pid=$(printf '%s' "$exact" | head -1)
      [ -n "$pid" ] || pid=$(herdr agent list 2>/dev/null | jq -r --arg ws "$ws" --arg n "$t" '
        .result.agents[]
        | select(.workspace_id == $ws and (.name // "") == $n)
        | .pane_id' | head -1)
      if [ -z "$pid" ]; then
        # 정확일치 실패 시에만 부분일치. 단 여러 개 걸리면 고르지 말고 죽는다 —
        # 조용히 첫 번째를 집으면 같은 워크스페이스 안에서도 오배송이 난다.
        local cands n
        cands=$(herdr pane list --workspace "$ws" 2>/dev/null | jq -r --arg n "$t" '
          .result.panes[] | select((.label // "") | contains($n))
          | "\(.label)\t\(.pane_id)"')
        n=$(printf '%s' "$cands" | grep -c . || true)
        if [ "$n" -gt 1 ]; then
          die "'$t' 에 여러 팀원이 걸립니다. 정확한 이름이나 pane_id로 지정하세요:
$cands"
        fi
        pid=$(printf '%s' "$cands" | cut -f2)
      fi
      ;;
  esac
  [ -n "$pid" ] || die "대상을 찾을 수 없습니다: '$t' (워크스페이스 $ws). 'orch-msg who'로 확인하세요."
  case "$pid" in
    "$ws":*) ;;
    *) die "워크스페이스 경계 위반 — $pid 는 $ws 소속이 아닙니다. 전송을 취소했습니다." ;;
  esac
  printf '%s' "$pid"
}

label_of() { # <pane_id>  — 사람이 읽는 이름은 팬 라벨(한글)이 정본이다
  local l
  l=$(herdr pane list 2>/dev/null | jq -r --arg p "$1" '
    .result.panes[] | select(.pane_id == $p) | (.label // "")' | head -1)
  [ -n "$l" ] || l=$(herdr agent list 2>/dev/null | jq -r --arg p "$1" '
    .result.agents[] | select(.pane_id == $p) | (.name // "-")' | head -1)
  printf '%s' "${l:--}"
}

# ── send ─────────────────────────────────────────────
cmd_send() {
  local target="${1:-}"; shift || true
  [ -n "$target" ] || die "사용법: orch-msg send <역할명|pane_id> <메시지...>"
  local msg="$*"
  [ -n "$msg" ] || die "메시지가 비어 있습니다"

  local ws pid label
  ws=$(resolve_ws)
  pid=$(resolve_target "$target" "$ws")
  label=$(label_of "$pid")

  # dispatch 기법: 잔여 입력 제거 → 텍스트 → 대기 → enter → 미제출이면 재시도
  herdr pane send-keys "$pid" escape >/dev/null 2>&1 || true
  herdr pane send-keys "$pid" ctrl+u  >/dev/null 2>&1 || true

  herdr pane send-text "$pid" \
    "[orch-msg] FROM:${ROLE} → TO:${label:-$pid} — ${msg} (회신: orch-msg send '${ROLE}' '<내용>')" >/dev/null
  sleep 2
  herdr pane send-keys "$pid" enter >/dev/null
  sleep 4
  if herdr pane read "$pid" --source visible --lines 6 2>/dev/null | grep -q "❯"; then
    herdr pane send-keys "$pid" enter >/dev/null 2>&1 || true
  fi

  ensure_log
  {
    printf '### %s | %s → %s (%s)\n\n' \
      "$(date '+%Y-%m-%d %H:%M:%S')" "$ROLE" "${label:-$pid}" "$pid"
    printf '%s\n\n' "$msg"
  } >> "$LOG"

  echo "전송됨 → ${label:-$pid} ($pid) · 기록: $LOG"
}

# ── log ──────────────────────────────────────────────
cmd_log() {
  local last=30 from="" to="" pat="" all=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --last) last="$2"; shift 2 ;;
      --from) from="$2"; shift 2 ;;
      --to)   to="$2";   shift 2 ;;
      --grep) pat="$2";  shift 2 ;;
      --all)  all=1;     shift ;;
      *) die "알 수 없는 옵션: $1" ;;
    esac
  done

  [ -f "$LOG" ] || { echo "(아직 기록이 없습니다: $LOG)"; return 0; }

  awk -v last="$last" -v from="$from" -v to="$to" -v pat="$pat" -v all="$all" '
    /^### / {
      if (nb > 0) blocks[nb] = buf
      nb++; buf = $0 "\n"
      hdr[nb] = $0
      next
    }
    { if (nb > 0) buf = buf $0 "\n"; else header = header $0 "\n" }
    END {
      if (nb > 0) blocks[nb] = buf
      # 필터
      m = 0
      for (i = 1; i <= nb; i++) {
        h = hdr[i]; b = blocks[i]
        if (from != "" && index(h, "| " from " →") == 0) continue
        if (to   != "" && index(h, "→ " to " (")  == 0) continue
        if (pat  != "" && index(b, pat) == 0) continue
        m++; sel[m] = b
      }
      if (m == 0) { print "(조건에 맞는 메시지가 없습니다)"; exit }
      start = (all == "1" || m <= last) ? 1 : m - last + 1
      if (start > 1) printf "(앞의 %d개 생략 — 전체는 --all)\n\n", start - 1
      for (i = start; i <= m; i++) printf "%s", sel[i]
    }
  ' "$LOG"
}

# ── who / whoami ─────────────────────────────────────
cmd_who() {
  local ws; ws=$(resolve_ws)
  echo "workspace $ws"
  herdr agent list | jq -r --arg ws "$ws" '.result.agents[]
    | select(.workspace_id == $ws)
    | "\(.agent_status)\t\(.name // "-")\t\(.pane_id)"' \
    | column -t -s "$(printf '\t')"
}

cmd_whoami() {
  local ws; ws=$(resolve_ws)
  printf '역할       %s\n' "$ROLE"
  printf '워크스페이스 %s\n' "$ws"
  printf 'pane       %s\n' "${MYPANE:-(미지정)}"
  printf '로그       %s\n' "$LOG"
}

# ── 디스패치 ─────────────────────────────────────────
case "${1:-}" in
  send)   shift; cmd_send "$@" ;;
  log)    shift; cmd_log "$@" ;;
  who)    shift; cmd_who ;;
  whoami) shift; cmd_whoami ;;
  -h|--help|"") sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "알 수 없는 명령: $1 (send|log|who|whoami)" ;;
esac
